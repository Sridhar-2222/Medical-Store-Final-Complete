# Copy to /opt/n8n/.env on the VPS, chmod 600. Never commit the filled file.
# Generate with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=
# Shared secret that Supabase Database Webhooks send in header `x-fingertip-secret`.
# Configure the same value in the n8n Webhook node's Header Auth credential.
FINGERTIP_WEBHOOK_SECRET=
