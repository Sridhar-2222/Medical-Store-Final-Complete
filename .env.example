# Copy to .env (local) or /etc/fingertip/app.env (VPS, chmod 600). Never commit real values.
SUPABASE_URL=https://<project-ref>.supabase.co
# Server-side key. Use a key whose role can read/write MEDICINES_TABLE only.
SUPABASE_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
MEDICINES_TABLE=medicines
LOW_STOCK_THRESHOLD=10
MAX_UPLOAD_MB=10
# Comma-separated allowed browser origins; empty = allow all (dev only)
CORS_ORIGINS=https://aipharmacy.in
HOST=127.0.0.1
PORT=10000
# Legacy unofficial WhatsApp-Web bot. Keep false: official channel is Meta Cloud API.
ENABLE_BAILEYS_BOT=false
BAILEYS_AUTH_DIR=/opt/fingertip/state/auth_info_final
